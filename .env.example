# Local docker-compose postgres (see docker-compose.yml)
POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:5432/aurora

# Required by Payload
PAYLOAD_SECRET=replace-with-a-long-random-string-for-cedar

# Vercel Blob (optional locally; required in production for uploads)
BLOB_READ_WRITE_TOKEN=

# Public site URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
