# Local docker-compose postgres (see docker-compose.yml)
POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:5432/aurora

# Required by Payload
PAYLOAD_SECRET=replace-with-a-long-random-string-for-cedar

# Gitee private repo used as media storage (required in production)
GITEE_OWNER=your-gitee-username
GITEE_REPO=cedar-assets
GITEE_TOKEN=your-gitee-private-token
# Optional; default master
GITEE_BRANCH=master

# Public site URL (production example: https://cedar-orpin.vercel.app)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional alias used by some Neon/Vercel templates
# DATABASE_URL=
